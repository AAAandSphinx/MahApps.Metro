<metro:MetroWindow
    x:Class="MahApps.Metro.Extension.Demo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MahApps.Metro.Extension.Demo"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:metro="http://metro.mahapps.com/winfx/xaml/controls"
    Title="MainWindow"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <metro:MetroWindow.DataContext>
        <local:MainWindowViewModel />
    </metro:MetroWindow.DataContext>
    <Grid>
        <metro:MetroTabControl metro:TabControlHelper.Underlined="TabPanel" Style="{StaticResource MahApps.Styles.TabControl.Animated}">
            <metro:MetroTabItem Header="PropertyGrid">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <metro:PropertyGrid
                        Grid.Row="1"
                        SelectedObject="{Binding PropertyGridModel}"
                        Visibility="Visible" />
                </Grid>
            </metro:MetroTabItem>
            <metro:MetroTabItem Header="ImageSelector">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <metro:ImageSelector Grid.Row="1" />
                </Grid>
            </metro:MetroTabItem>
        </metro:MetroTabControl>
    </Grid>
</metro:MetroWindow>
