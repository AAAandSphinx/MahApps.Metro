<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    mc:Ignorable="po">

    <!--  Background  -->
    <SolidColorBrush
        x:Key="MahApps.Brushes.Background"
        po:Freeze="True"
        Color="#1C1C1C" />
    <SolidColorBrush
        x:Key="MahApps.Brushes.LightBackground"
        po:Freeze="True"
        Color="#2D2D30" />

    <Color x:Key="MahApps.Colors.Accent">#2D2D30</Color>
    <Color x:Key="MahApps.Colors.ThemeForeground">#FFFFFFFF</Color>
    <Color x:Key="MahApps.Colors.ThemeBackground">#2D2D30</Color>
    <Color x:Key="MahApps.Colors.MenuShadow">#FF000000</Color>

    <!--  re-set brushes too  -->
    <SolidColorBrush
        x:Key="MahApps.Brushes.Highlight"
        po:Freeze="True"
        Color="{StaticResource MahApps.Colors.Highlight}" />
    <SolidColorBrush
        x:Key="MahApps.Brushes.Accent"
        po:Freeze="True"
        Color="{StaticResource MahApps.Colors.Accent}" />
    <SolidColorBrush
        x:Key="MahApps.Brushes.Accent2"
        po:Freeze="True"
        Color="{StaticResource MahApps.Colors.Accent2}" />
    <SolidColorBrush
        x:Key="MahApps.Brushes.Accent3"
        po:Freeze="True"
        Color="{StaticResource MahApps.Colors.Accent3}" />
    <SolidColorBrush
        x:Key="MahApps.Brushes.Accent4"
        po:Freeze="True"
        Color="{StaticResource MahApps.Colors.Accent4}" />

    <SolidColorBrush
        x:Key="MahApps.Brushes.WindowTitle"
        po:Freeze="True"
        Color="{StaticResource MahApps.Colors.Accent}" />
    <SolidColorBrush
        x:Key="MahApps.Brushes.WindowTitle.NonActive"
        po:Freeze="True"
        Color="#808080" />
    <SolidColorBrush
        x:Key="MahApps.Brushes.Border.NonActive"
        po:Freeze="True"
        Color="#808080" />

    <SolidColorBrush
        x:Key="MahApps.Brushes.ThemeForeground"
        po:Freeze="True"
        Color="{StaticResource MahApps.Colors.ThemeForeground}" />
    <SolidColorBrush
        x:Key="MahApps.Brushes.Text"
        po:Freeze="True"
        Color="{StaticResource MahApps.Colors.ThemeForeground}" />
    <SolidColorBrush
        x:Key="MahApps.Brushes.TextBox.Border.Focus"
        po:Freeze="True"
        Color="{StaticResource MahApps.Colors.ThemeForeground}" />
    <SolidColorBrush
        x:Key="MahApps.Brushes.Button.Border.MouseOver"
        po:Freeze="True"
        Color="{StaticResource MahApps.Colors.ThemeForeground}" />
    <SolidColorBrush
        x:Key="MahApps.Brushes.ComboBox.Border.MouseOver"
        po:Freeze="True"
        Color="{StaticResource MahApps.Colors.ThemeForeground}" />

    <SolidColorBrush
        x:Key="MahApps.Brushes.Control.Background"
        po:Freeze="True"
        Color="{StaticResource MahApps.Colors.ThemeBackground}" />
    <SolidColorBrush
        x:Key="MahApps.Brushes.ThemeBackground"
        po:Freeze="True"
        Color="{StaticResource MahApps.Colors.ThemeBackground}" />
    <SolidColorBrush
        x:Key="MahApps.Brushes.Window.Background"
        po:Freeze="True"
        Color="{StaticResource MahApps.Colors.ThemeBackground}" />

    <SolidColorBrush
        x:Key="{x:Static SystemColors.WindowBrushKey}"
        po:Freeze="True"
        Color="{StaticResource MahApps.Colors.ThemeBackground}" />
    <SolidColorBrush
        x:Key="{x:Static SystemColors.ControlTextBrushKey}"
        po:Freeze="True"
        Color="{StaticResource MahApps.Colors.ThemeForeground}" />

    <SolidColorBrush
        x:Key="MahApps.Brushes.WindowButtonCommands.Background.MouseOver"
        po:Freeze="True"
        Color="#40808080" />

    <!--  Foreground  -->
    <SolidColorBrush
        x:Key="MahApps.Brushes.Foreground"
        po:Freeze="True"
        Color="#FFFFFF" />
    <SolidColorBrush
        x:Key="MahApps.Brushes.WindowTitle.Foreground"
        po:Freeze="True"
        Color="#999988" />

    <!--  General  -->
    <SolidColorBrush
        x:Key="MahApps.Brushes.BackgroundHighlighted"
        po:Freeze="True"
        Color="#54545C" />
    <SolidColorBrush
        x:Key="MahApps.Brushes.Border.Highlighted"
        po:Freeze="True"
        Color="#6A6A75" />
    <SolidColorBrush
        x:Key="MahApps.Brushes.BackgroundSelected"
        po:Freeze="True"
        Color="#007ACC" />
    <SolidColorBrush
        x:Key="MahApps.Brushes.Border.Selected"
        po:Freeze="True"
        Color="#1C97EA" />
    <SolidColorBrush
        x:Key="MahApps.Brushes.Background.Normal"
        po:Freeze="True"
        Color="#3F3F46" />
    <SolidColorBrush
        x:Key="MahApps.Brushes.Border.Normal"
        po:Freeze="True"
        Color="#54545C" />
    <SolidColorBrush
        x:Key="MahApps.Brushes.Window.Glow"
        po:Freeze="True"
        Color="#017ACC" />

    <!--  Text Box  -->
    <SolidColorBrush
        x:Key="MahApps.Brushes.TextBox.Background"
        po:Freeze="True"
        Color="#333337" />
    <SolidColorBrush
        x:Key="MahApps.Brushes.TextBox.BackgroundSelected"
        po:Freeze="True"
        Color="#3F3F46" />

    <!--  Search Text Box  -->
    <SolidColorBrush
        x:Key="MahApps.Brushes.SearchTextBox.Foreground"
        po:Freeze="True"
        Color="#999999" />

    <!--  Link Button  -->
    <SolidColorBrush
        x:Key="MahApps.Brushes.LinkButton.Foreground"
        po:Freeze="True"
        Color="#1297FB" />
    <SolidColorBrush
        x:Key="MahApps.Brushes.LinkButton.ForegroundHighlighted"
        po:Freeze="True"
        Color="#55AAFF" />

    <!--  Close Button  -->
    <SolidColorBrush
        x:Key="MahApps.Brushes.CloseButton.BackgroundHighlighted"
        po:Freeze="True"
        Color="#39ADFB" />
    <SolidColorBrush
        x:Key="MahApps.Brushes.CloseButton.BackgroundPressed"
        po:Freeze="True"
        Color="#084E7D" />
    <SolidColorBrush
        x:Key="MahApps.Brushes.CloseButton.Stroke"
        po:Freeze="True"
        Color="#AAFFFFFF" />
    <SolidColorBrush
        x:Key="MahApps.Brushes.CloseButton.StrokeHighlighted"
        po:Freeze="True"
        Color="#FFFFFF" />

    <!--  Menu  -->
    <SolidColorBrush
        x:Key="MahApps.Brushes.Menu.Checkmark.Fill"
        po:Freeze="True"
        Color="#FF999999" />
    <SolidColorBrush
        x:Key="MahApps.Brushes.Menu.Checkmark.Background"
        po:Freeze="True"
        Color="#FF2D2D30" />
    <SolidColorBrush
        x:Key="MahApps.Brushes.MenuSeparator.Border"
        po:Freeze="True"
        Color="#333337" />
    <SolidColorBrush
        x:Key="MahApps.Brushes.MenuItem.BackgroundHighlighted"
        po:Freeze="True"
        Color="#3E3E40" />
    <SolidColorBrush
        x:Key="MahApps.Brushes.SubmenuItem.Background"
        po:Freeze="True"
        Color="#1B1B1C" />
    <SolidColorBrush
        x:Key="MahApps.Brushes.SubmenuItem.BackgroundHighlighted"
        po:Freeze="True"
        Color="#333334" />
    <SolidColorBrush
        x:Key="MahApps.Brushes.Menu.ForegroundDisabled"
        po:Freeze="True"
        Color="#656565" />
    <SolidColorBrush
        x:Key="MahApps.Brushes.ContextMenu.Background"
        po:Freeze="True"
        Color="#1B1B1C" />
    <SolidColorBrush
        x:Key="MahApps.Brushes.ContextMenu.Border"
        po:Freeze="True"
        Color="#333337" />
    <SolidColorBrush
        x:Key="{x:Static SystemColors.MenuTextBrushKey}"
        po:Freeze="True"
        Color="#FFFFFF" />

    <system:Double x:Key="MahApps.Font.Size.ContextMenu">12</system:Double>

    <!--  Scroll Bar  -->
    <SolidColorBrush
        x:Key="MahApps.Brushes.ScrollBar.PageButtonBackgroundHighlighted"
        po:Freeze="True"
        Color="#05FFFFFF" />

    <!--  Notification Button  -->
    <SolidColorBrush x:Key="MahApps.Brushes.NotificationButton.Foreground" Color="#000000" />
    <SolidColorBrush x:Key="MahApps.Brushes.NotificationButton.Background" Color="#FFCC00" />
    <SolidColorBrush x:Key="MahApps.Brushes.NotificationButton.BackgroundOver" Color="#FFDF66" />
    <SolidColorBrush x:Key="MahApps.Brushes.NotificationButton.BackgroundPressed" Color="#C59E00" />

    <!--  Quick Launch TextBox  -->
    <SolidColorBrush x:Key="MahApps.Brushes.QuickLaunchTextBox.Border" Color="#3F3F46" />
    <SolidColorBrush x:Key="MahApps.Brushes.QuickLaunchTextBox.FocusedBorder" Color="#007ACC" />

</ResourceDictionary>