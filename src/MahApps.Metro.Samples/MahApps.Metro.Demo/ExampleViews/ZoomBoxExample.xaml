<UserControl
    x:Class="MetroDemo.ExampleViews.ZoomBoxExample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MetroDemo.ExampleViews"
    xmlns:mahs="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid Margin="5">
        <mahs:Zoombox BorderBrush="{DynamicResource MahApps.Brushes.Accent}" BorderThickness="1">
            <local:ButtonsExample />
        </mahs:Zoombox>
    </Grid>
</UserControl>
